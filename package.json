{
  "name": "multi-agent-cs-crew",
  "version": "1.0.0",
  "description": "Capstone project: a customer-facing multi-agent support chat crew, built with the [AAMAD](https://pypi.org/project/aamad/) multi-agent development framework.",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:invariants": "node --import ./scripts/test-resolver.mjs --test server/runtime/toolRegistry.test.ts",
    "test": "node --import ./scripts/test-resolver.mjs --test server/runtime/*.test.ts server/data/*.test.ts lib/*.test.ts lib/services/*.test.ts packages/shared/src/*.test.ts",
    "eval:sdk": "node scripts/eval-sdk.mjs",
    "observability": "node scripts/observability.mjs",
    "prune:traces": "node --import ./scripts/test-resolver.mjs scripts/prune-traces.mjs",
    "query": "node scripts/query.mjs",
    "demo:build": "node scripts/build-demo-scenarios.mjs",
    "demo": "bash scripts/demo.sh",
    "demo:runsheet": "python3 scripts/build-demo-runsheet.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmatx/multi-agent-cs-crew.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rmatx/multi-agent-cs-crew/issues"
  },
  "homepage": "https://github.com/rmatx/multi-agent-cs-crew#readme",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@arizeai/openinference-semantic-conventions": "^2.9.0",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  }
}
