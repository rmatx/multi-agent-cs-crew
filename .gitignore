.DS_Store
**/.DS_Store

# Environments and secrets
.venv/
.env
.env.local

# Node
node_modules/
dist/
.next/

# Local-only Claude Code state
.claude/settings.local.json
.claude-state/

# AAMAD runtime logs
project-context/2.build/logs/

# NovaMart practice DB — 151 MB, over GitHub's 100 MB hard limit.
# Keep the full DB local: point NOVAMART_DUCKDB_PATH at it, or drop a copy in
# data/fixtures/. The slimmed CI fixture (ADR-12) is the exception below.
data/fixtures/*.duckdb
!data/fixtures/novamart_ci.duckdb

# Handoff artifacts. Human-readable ticket packets and the simulated outbound queue — they
# carry the SAME customer content as the trace logs (SEC-03), PII-scrubbed at write and swept
# by `npm run prune:traces`. Ignored for the same reason the logs are: .gitignore prevents
# commit, which is the one thing it is good for.
data/tickets/
data/outbox.md

# Runtime-generated stores (SQLite, ADR-10)
data/*.sqlite

# TypeScript incremental build info
*.tsbuildinfo

# SQLite sidecar files (ADR-10). The .sqlite files are ignored above; WAL mode adds these.
data/*.sqlite-wal
data/*.sqlite-shm

# Browser-driven verification artifacts (Playwright MCP snapshots and console logs).
.playwright-mcp/

# Office lock files
~$*
