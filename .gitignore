.DS_Store
**/.DS_Store

# Environments and secrets
.venv/
.env
.env.local

# Node
node_modules/
dist/
.next/

# Local-only Claude Code state
.claude/settings.local.json
.claude-state/

# AAMAD runtime logs
project-context/2.build/logs/

# NovaMart practice DB — 151 MB, over GitHub's 100 MB hard limit.
# Keep the full DB local: point NOVAMART_DUCKDB_PATH at it, or drop a copy in
# data/fixtures/. The slimmed CI fixture (ADR-12) is the exception below.
data/fixtures/*.duckdb
!data/fixtures/novamart_ci.duckdb

# Runtime-generated stores (SQLite, ADR-10)
data/*.sqlite
