#!/usr/bin/env bash
#
# Refuse to commit a live secret.
#
# WHY THIS EXISTS: on 2026-09-08 the deployment's real `FINAL_DEMO_PASSWORD` was committed to
# this public repository as a test fixture in `server/runtime/demoGate.test.ts`. It was caught
# and the password rotated, but the class of mistake — a fixture written to mirror a live
# credential — will recur, because mirroring the real value is the intuitive thing to do.
#
# THE HOOK ITSELF CONTAINS NO SECRETS, and that is not incidental. A guard with the password
# baked in would publish the password to defend the password. Instead it reads the values it
# should refuse from `.env.local`, which is gitignored, so the list of things to protect stays
# on this machine and stays current for free.
#
# Bypass with `git commit --no-verify` when you genuinely mean it (a redaction fixture that has
# to contain a realistic shape, say). The hook tells you so when it fires.

set -uo pipefail

fail=0
note() { printf '\n\033[31mblocked:\033[0m %s\n' "$1" >&2; fail=1; }

# Added lines only. A deletion that removes a secret must not be blocked — that is the fix, and
# refusing it would trap the very commit that cleans up.
staged_added="$(git diff --cached --no-color --diff-filter=ACM -U0 | grep '^+' | grep -v '^+++' || true)"
staged_files="$(git diff --cached --name-only --diff-filter=ACM || true)"

# 1. Never commit the local env file itself, whatever .gitignore currently says.
if printf '%s\n' "$staged_files" | grep -qE '(^|/)\.env(\.local)?$'; then
  note "an environment file is staged (.env / .env.local). These hold live values and belong only on this machine."
fi

# 2. Real credential shapes. Deliberately NARROW so the repo's existing synthetic fixtures
#    (sk-ant-abcdefghijklmnop, used to test redaction) keep working — a guard that cries wolf
#    gets disabled, and a disabled guard protects nothing.
if printf '%s\n' "$staged_added" | grep -qE 'sk-ant-api[0-9]{2}-'; then
  note "a real Anthropic API key format (sk-ant-apiNN-) appears in staged changes."
fi
# Split across two assignments on purpose: written as one literal, this pattern MATCHES ITSELF,
# and the hook refused the commit that introduced it. Neither half matches the composed pattern
# alone, so the guard still scans its own source rather than being exempted from it — an
# exemption would be a blind spot in the one file most worth keeping clean.
priv_head='-----BEGIN '
priv_tail='PRIVATE KEY-----'
if printf '%s\n' "$staged_added" | grep -q -- "${priv_head}.*${priv_tail}"; then
  note "a private key block appears in staged changes."
fi

# 3. Any value currently live in .env.local. This is what actually catches the password, and it
#    needs no maintenance: rotate a secret there and the guard protects the new one immediately.
if [ -f .env.local ]; then
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue ;; esac
    key="${line%%=*}"
    value="${line#*=}"
    # Strip one layer of surrounding quotes.
    value="${value%\"}"; value="${value#\"}"
    value="${value%\'}"; value="${value#\'}"
    # Which values are worth checking, and this is the part that has already been wrong once:
    # a flat "length >= 12" rule skipped a 9-character password, i.e. the exact secret the hook
    # was written to protect. Length alone cannot tell a secret from a setting.
    #
    # So classify by NAME first. A variable whose name says it holds a credential is checked
    # even when its value is short; anything else must be long enough that matching it is
    # unlikely to be a coincidence. That keeps DEMO_MODE=1, MODEL_ID=claude-sonnet-5 and
    # CHAT_ENGINE=deterministic out of the way without letting a short password through.
    case "$key" in
      *PASSWORD*|*PASSWD*|*SECRET*|*TOKEN*|*CREDENTIAL*|*_KEY|*KEY_*|*APIKEY*)
        min=6 ;;
      *)
        min=16 ;;
    esac
    [ "${#value}" -ge "$min" ] || continue
    if printf '%s\n' "$staged_added" | grep -qF -- "$value"; then
      note "the live value of \$$key from .env.local appears in staged changes."
    fi
  done < .env.local
fi

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

  Nothing was committed. Use a synthetic value in fixtures and keep real ones in .env.local.
  If this is a deliberate, reviewed exception: git commit --no-verify

MSG
  exit 1
fi
exit 0
