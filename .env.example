# NovaMart support crew — env var NAMES ONLY. Never commit values.
# Copy to .env.local and fill in locally.

AAMAD_TARGET_RUNTIME=
NOVAMART_DUCKDB_PATH=
DEMO_OVERLAY_PATH=
ALIGN_MAX_DATE_TO_TODAY=
AS_OF_DATE=
DATE_SHIFT_DAYS=
POLICY_CORPUS_PATH=
TICKET_STUB_DB_PATH=
SESSION_DB_PATH=
ANTHROPIC_API_KEY=
MODEL_ID=
MAX_HOPS=
TURN_TIMEOUT_MS=
OPERATOR_KEY=
PORT=

# --- Backend runtime (@backend.eng, *develop-be) — NAMES ONLY, no values ---
# deterministic (default, keyless) | sdk (opt-in claude-agent-sdk crew)
CHAT_ENGINE=
# sdk engine only: final (default, buffer coordinator text) | live (stream deltas)
SDK_STREAM_MODE=
# Explicit execution budgets. Unset = SAD defaults (see backend.md), never an SDK default.
MAX_MODEL_TURNS=
MAX_OUTPUT_TOKENS=
# Thinking depth: low (default) | medium | high | xhigh | max. This is the determinism /
# cost lever. There is no MODEL_TEMPERATURE: temperature was removed from the Messages API
# on Opus 5 / Sonnet 5 / Opus 4.7+ and the Agent SDK exposes no temperature option.
MODEL_EFFORT=
# OLDER models only (e.g. claude-haiku-4-5), which take a fixed thinking budget. Leave UNSET
# on Opus 4.6+ / Sonnet 4.6+ / Opus 5 / Sonnet 5 — those use adaptive thinking.
MAX_THINKING_TOKENS=
TOOL_READ_RETRIES=

# --- Frontend (@project.mgr, *configure-env) — NAMES ONLY, no values ---
# Set to 1 to drive the UI from lib/services/mockStream.ts instead of POST /api/chat.
# NEXT_PUBLIC_* is inlined into the client bundle at build time — never put a secret here.
NEXT_PUBLIC_USE_MOCK_STREAM=
