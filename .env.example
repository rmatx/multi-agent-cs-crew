# NovaMart support crew — env var NAMES ONLY. Never commit values.
# Copy to .env.local and fill in locally.

AAMAD_TARGET_RUNTIME=
NOVAMART_DUCKDB_PATH=
DEMO_OVERLAY_PATH=
ALIGN_MAX_DATE_TO_TODAY=
AS_OF_DATE=
DATE_SHIFT_DAYS=
POLICY_CORPUS_PATH=
TICKET_STUB_DB_PATH=
SESSION_DB_PATH=
# Root of everything the app WRITES: the handoff ticket packets and outbox.md. Unset = ./data.
# In a container this must point at the mounted volume (the image sets /app/var), because ./data
# there also holds READ-ONLY things — the DuckDB fixture and the policy corpus — and a volume
# mounted over them would leave the app with no data to answer from.
NOVAMART_STATE_DIR=
# Where per-conversation trace JSONL is written. Unset = ./project-context/2.build/logs.
# Must agree with NOVAMART_STATE_DIR's volume in a container, or traces are lost on redeploy.
TRACE_LOG_DIR=
ANTHROPIC_API_KEY=
MODEL_ID=
MAX_HOPS=
TURN_TIMEOUT_MS=
# Shared demo secret for GET /api/conversations/:id/trace. UNSET = the operator trace
# endpoint is DISABLED (503), never open. Set it to enable operator access.
OPERATOR_KEY=
# Turns per minute per client for POST /api/chat. Unset = 20. 0 disables the limit.
RATE_LIMIT_PER_MIN=
# Set to 1 ONLY where TLS terminates in front of the app (Railway does; localhost does not).
# Sends Strict-Transport-Security. Over plain HTTP it is ignored; from a host that does not
# serve HTTPS it pins a browser to a scheme that is not there.
ENABLE_HSTS=
# Injected by most platforms (Railway sets it). Unset = 3000.
PORT=

# --- Backend runtime (@backend.eng, *develop-be) — NAMES ONLY, no values ---
# deterministic (default, keyless) | sdk (opt-in claude-agent-sdk crew)
CHAT_ENGINE=
# sdk engine only: final (default, buffer coordinator text) | live (stream deltas)
SDK_STREAM_MODE=
# Explicit execution budgets. Unset = SAD defaults (see backend.md), never an SDK default.
MAX_MODEL_TURNS=
MAX_OUTPUT_TOKENS=
# Thinking depth: low (default) | medium | high | xhigh | max. This is the determinism /
# cost lever. There is no MODEL_TEMPERATURE: temperature was removed from the Messages API
# on Opus 5 / Sonnet 5 / Opus 4.7+ and the Agent SDK exposes no temperature option.
MODEL_EFFORT=
# OLDER models only (e.g. claude-haiku-4-5), which take a fixed thinking budget. Leave UNSET
# on Opus 4.6+ / Sonnet 4.6+ / Opus 5 / Sonnet 5 — those use adaptive thinking.
MAX_THINKING_TOKENS=
TOOL_READ_RETRIES=
# The only outbound host in this system (Nager.Date public-holiday calendar, keyless).
# Operator setting, never model-supplied. Unset = https://date.nager.at, 3000 ms.
HOLIDAY_API_BASE_URL=
HOLIDAY_TIMEOUT_MS=

# --- Frontend (@project.mgr, *configure-env) — NAMES ONLY, no values ---
# Set to 1 to drive the UI from lib/services/mockStream.ts instead of POST /api/chat.
# NEXT_PUBLIC_* is inlined into the client bundle at build time — never put a secret here.
NEXT_PUBLIC_USE_MOCK_STREAM=
# Set to 1 to show the demo scenario picker. OPERATOR TOOL — it lists real order ids belonging
# to other customers, so it must never be on for a customer-facing session. `?demo=1` on the URL
# does the same for a one-off session without a rebuild.
#
# LOCAL DEV ONLY. Being a NEXT_PUBLIC_* var, this is inlined by `next build` and is inert in a
# built image — setting it in a compose file or a platform variable table does nothing (DEF-17).
# Deployments use DEMO_MODE below.
NEXT_PUBLIC_DEMO_MODE=

# --- Demo surface (@devops.eng) ---
# Set to 1 to serve the demo surface — crew strip, 23-scenario picker, handoff packet. Read on
# the SERVER per request and reported through /api/health, so a deployment turns it on with a
# restart and no rebuild. This is the one that works in a container. Strictly "1"; anything
# else, "true" included, is off.
DEMO_MODE=

# Trace-log retention in days (SEC-03). Default 7. `0` keeps only today's.
# Pruning is explicit: `npm run prune:traces`, or from cron on a long-lived host.
TRACE_RETENTION_DAYS=
