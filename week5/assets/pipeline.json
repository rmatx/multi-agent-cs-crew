{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "From a commit to confidence",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "free",
        "label": "What runs on every push",
        "focus": [
          "commit",
          "typecheck",
          "unit",
          "invariant",
          "image"
        ],
        "note": "Keyless by design, so a fork or a pull request runs the whole suite without a secret and without spending anything."
      },
      {
        "id": "paid",
        "label": "What needs a key",
        "focus": [
          "evalsdk",
          "goldens",
          "spendgate"
        ],
        "note": "Model behaviour regresses with no code change, so it needs its own gate \u2014 manual and monthly, never on pull_request."
      },
      {
        "id": "evidence",
        "label": "What it produces",
        "focus": [
          "traces",
          "arize",
          "qa"
        ],
        "note": "Every claim in the QA and eval artifacts traces to a run rather than to an assertion in prose."
      }
    ]
  },
  "lanes": [
    {
      "id": "keyless",
      "label": "CI \u2014 keyless, every push"
    },
    {
      "id": "keyed",
      "label": "Eval \u2014 keyed, manual + monthly"
    },
    {
      "id": "evidence",
      "label": "Evidence"
    }
  ],
  "phases": [
    {
      "id": "p1",
      "label": "Prove it compiles and is safe",
